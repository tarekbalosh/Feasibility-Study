generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ——————————————————————————————————————————————
// Users table
// ——————————————————————————————————————————————
model User {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  subscriptionTier        String    @default("free") @map("subscription_tier")
  subscriptionStatus      String    @default("none") @map("subscription_status")
  stripeCustomerId        String?   @map("stripe_customer_id")
  isVerified              Boolean   @default(false) @map("is_verified")
  verificationToken       String?   @map("verification_token")
  verificationTokenExpiry DateTime? @map("verification_token_expiry")
  resetToken              String?   @map("reset_token")
  resetTokenExpiry        DateTime? @map("reset_token_expiry")
  role                    String    @default("user")
  status                  String    @default("active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  projects  Project[]
  payments  Payment[]
  userLimit UserLimit?

  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  toolRuns             ToolRun[]
  pestAnalyses         PestAnalysis[]
  pestFactors          PestFactor[]
  pestGenerationLogs   PestGenerationLog[]
  porterAnalyses       PorterAnalysis[]

  createdConversations   Conversation[]       @relation("ConversationCreator")
  conversationMemberships ConversationMember[]
  sentMessages           Message[]
  userPresence           UserPresence?
  calls                  Call[]               @relation("CallCaller")

  @@map("users")
}

// ——————————————————————————————————————————————
// Projects table
// ——————————————————————————————————————————————
model Project {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  industry        String
  location        String
  currency        String   @default("USD")
  targetCapital   Float    @map("target_capital")
  durationYears   Int      @default(3) @map("duration_years")
  description     String
  financialInputs String   @map("financial_inputs") // JSON stored as string
  aiOutput        String?  @map("ai_output") // JSON stored as string
  financialOutput String?  @map("financial_output") // JSON stored as string
  isShared        Boolean  @default(false) @map("is_shared")
  shareToken      String?  @unique @map("share_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ——————————————————————————————————————————————
// Payments table
// ——————————————————————————————————————————————
model Payment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  stripeSessionId String   @unique @map("stripe_session_id")
  amount          Float
  currency        String
  status          String
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("payments")
}

// ——————————————————————————————————————————————
// User limits table
// ——————————————————————————————————————————————
model UserLimit {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  generationsUsed  Int      @default(0) @map("generations_used")
  generationsLimit Int      @default(1) @map("generations_limit")
  resetAt          DateTime @map("reset_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_limits")
}

// ——————————————————————————————————————————————
// Workspaces — مساحة العمل: الحاوية الإلزامية لأي استخدام للأدوات
// ——————————————————————————————————————————————
model Workspace {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  invites        WorkspaceInvite[]
  toolRuns       ToolRun[]
  departments    Department[]
  plans          Plan[]
  pestAnalyses   PestAnalysis[]
  porterAnalyses PorterAnalysis[]
  conversations  Conversation[]
  calls          Call[]

  @@index([ownerId])
  @@map("workspaces")
}

// ——————————————————————————————————————————————
// Workspace members — العضوية الفعلية (والمعلّقة) داخل مساحة العمل
//   role:   owner | admin | member | viewer
//   status: active | invited | pending
// القيود الفعلية (CHECK) تُطبَّق عبر prisma/sql/workspace_constraints.sql
// لأن Prisma لا يعبّر عن CHECK في المخطط.
// ——————————————————————————————————————————————
model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String?   @map("user_id")
  email       String
  role        String    @default("member")
  status      String    @default("invited")
  invitedAt   DateTime  @default(now()) @map("invited_at")
  joinedAt    DateTime? @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentMemberships DepartmentMember[]
  planMemberships       PlanMember[]
  projectPermissions    ProjectPermission[]
  assignedTasks         PlanTask[]          @relation("TaskAssignee")
  followedTasks         PlanTask[]          @relation("TaskFollower")

  // البريد مخزَّن بحروف صغيرة دائماً، فالمفتاح المركّب يمنع تكرار العضو
  @@unique([workspaceId, email])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

// ——————————————————————————————————————————————
// Workspace invites — دعوة بالبريد مع رمز عشوائي وتاريخ انتهاء
// ——————————————————————————————————————————————
model WorkspaceInvite {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String?
  email       String
  token       String   @unique
  role        String   @default("member")
  expiresAt   DateTime @map("expires_at")
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([workspaceId])
  @@map("workspace_invites")
}

// ——————————————————————————————————————————————
// Login codes — الدخول بالبريد فقط (رمز من 6 أرقام)
// ——————————————————————————————————————————————
//  الرمز لا يُخزَّن نصاً: نحفظ HMAC-SHA256 مفتاحه JWT_SECRET، فتسريب
//  قاعدة البيانات وحده لا يكفي لاشتقاق الرموز.
//  name يُملأ حين يأتي الطلب من شاشة إنشاء مساحة العمل، فيُستخدم
//  لإنشاء الحساب عند التحقق دون سؤال المستخدم مرّتين.
// ——————————————————————————————————————————————
model LoginCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  name       String?
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, consumedAt])
  @@index([expiresAt])
  @@map("login_codes")
}

// ——————————————————————————————————————————————
// Tool runs — مخرجات الأدوات المحفوظة
// ——————————————————————————————————————————————
//  سجل موحّد لكل الأدوات بدل جدول لكل أداة: الأداة الجديدة تُحفظ
//  وتظهر في لوحة التحكم دون أي تغيير في المخطط.
//  input/output نصوص JSON — يطابق أسلوب Project في هذا المشروع
//  ويُبقي شكل كل أداة حرّاً.
//  الملكية لمساحة العمل لا للمستخدم: زميلك يرى تحليلك، وخروج عضو
//  من الفريق لا يُفقد الفريق عمله. userId يبقى للنسبة (من أنشأه).
// ——————————————————————————————————————————————
model ToolRun {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  toolSlug    String   @map("tool_slug")
  title       String
  summary     String?
  input       String
  output      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ——— المشروع داخل الهيكل التنظيمي ———
  //  departmentId: القسم المالك للمشروع (إلزامي منطقياً للعضو العادي)
  //  planId:       الخطة التي شُغّلت الأداة من داخلها (اختياري)
  //  visibility:   department = يراه كل أعضاء القسم
  //                restricted = الأعضاء المختارون فقط (+ المالك والمشرفون)
  departmentId String? @map("department_id")
  planId       String? @map("plan_id")
  visibility   String  @default("department")

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  plan            Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  swotCustomGoals SwotCustomGoal[]
  permissions     ProjectPermission[]
  sourcedGoals    PlanGoal[]
  pestAnalysis    PestAnalysis?
  porterAnalysis  PorterAnalysis?

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, toolSlug])
  @@index([departmentId])
  @@index([planId])
  @@map("tool_runs")
}

// ——————————————————————————————————————————————
// Departments — أقسام مساحة العمل (التسويق، المالية…)
// ——————————————————————————————————————————————
model Department {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  color       String   @default("indigo")
  icon        String   @default("building")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        DepartmentMember[]
  plans          Plan[]
  toolRuns       ToolRun[]
  pestAnalyses   PestAnalysis[]
  porterAnalyses PorterAnalysis[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("departments")
}

//  role: head | member — العضو قد ينتمي لأكثر من قسم
model DepartmentMember {
  id                String   @id @default(uuid())
  departmentId      String   @map("department_id")
  workspaceMemberId String   @map("workspace_member_id")
  role              String   @default("member")
  createdAt         DateTime @default(now()) @map("created_at")

  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, workspaceMemberId])
  @@index([workspaceMemberId])
  @@map("department_members")
}

// ——————————————————————————————————————————————
// Plans — خطة تشغيلية لقسم: أهداف + مهام + فريق + مشاريع
//   status: draft | active | on_hold | completed | archived
// ——————————————————————————————————————————————
model Plan {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  departmentId String    @map("department_id")
  name         String
  description  String?
  status       String    @default("active")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: لا يُحذف قسم وفيه خطط — الخدمة ترفض الحذف برسالة واضحة
  department Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  members    PlanMember[]
  goals      PlanGoal[]
  tasks      PlanTask[]
  toolRuns   ToolRun[]

  @@index([workspaceId, status])
  @@index([departmentId])
  @@map("plans")
}

//  role: lead | contributor | viewer
model PlanMember {
  id                String   @id @default(uuid())
  planId            String   @map("plan_id")
  workspaceMemberId String   @map("workspace_member_id")
  role              String   @default("contributor")
  createdAt         DateTime @default(now()) @map("created_at")

  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([planId, workspaceMemberId])
  @@index([workspaceMemberId])
  @@map("plan_members")
}

//  status: not_started | in_progress | completed
//  نسبة الإنجاز تُحسب من أوزان المهام وتقدّمها — لا تُخزَّن
model PlanGoal {
  id          String    @id @default(uuid())
  planId      String    @map("plan_id")
  title       String
  description String?
  weight      Int       @default(1)
  dueDate     DateTime? @map("due_date")
  status      String    @default("not_started")
  order       Int       @default(0)
  sourceRunId String?   @map("source_run_id") // المشروع الذي اشتُقّ منه الهدف
  // المرجع في عرض الجدول: kpi | swot | need — وتفصيله (مثل «2 مليون» أو «قلة المحترفين»)
  referenceType   String? @map("reference_type")
  referenceDetail String? @map("reference_detail")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceRun ToolRun?   @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  tasks     PlanTask[]

  @@index([planId, order])
  @@map("plan_goals")
}

//  status:   todo | in_progress | review | done
//  priority: low | medium | high | urgent
model PlanTask {
  id               String    @id @default(uuid())
  planId           String    @map("plan_id")
  goalId           String?   @map("goal_id")
  title            String
  description      String?
  assigneeMemberId String?   @map("assignee_member_id")
  assigneeName     String?   @map("assignee_name")
  followerName     String?   @map("follower_name")
  // المعني بالمتابعة كعضو فعلي (يُستخدم في الصلاحيات)؛ followerName يبقى للتوافق
  followerMemberId String?   @map("follower_member_id")
  need             String?   // الاحتياج
  party            String?   // الجهة
  dueDate          DateTime? @map("due_date")
  priority         String    @default("medium")
  status           String    @default("todo")
  progress         Int       @default(0)
  weight           Int       @default(1)
  cost             Float     @default(0)
  order            Int       @default(0)
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  plan     Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal     PlanGoal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  assignee WorkspaceMember? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  follower WorkspaceMember? @relation("TaskFollower", fields: [followerMemberId], references: [id], onDelete: SetNull)

  @@index([planId, status])
  @@index([goalId])
  @@index([assigneeMemberId])
  @@index([followerMemberId])
  @@map("plan_tasks")
}

// ——————————————————————————————————————————————
// Project permissions — صلاحية عضو محدد على مشروع (ToolRun)
//   level: view | edit | manage
// ——————————————————————————————————————————————
model ProjectPermission {
  id                String   @id @default(uuid())
  toolRunId         String   @map("tool_run_id")
  workspaceMemberId String   @map("workspace_member_id")
  level             String   @default("view")
  createdAt         DateTime @default(now()) @map("created_at")

  toolRun         ToolRun         @relation(fields: [toolRunId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([toolRunId, workspaceMemberId])
  @@index([workspaceMemberId])
  @@map("project_permissions")
}

model FeasibilityStudy {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  sector         String
  detectedSector String? // AI-detected sector when user selects "Other"
  rawData        String // store JSON as string
  resultData     String // store JSON as string
  reportHtml     String?
  reportPdf      String?
}

// ——————————————————————————————————————————————
// SWOT Custom Goals — أهداف استراتيجية مخصصة للعميل
// ——————————————————————————————————————————————
model SwotCustomGoal {
  id                  String   @id @default(uuid())
  swotAnalysisId      String   @map("swot_analysis_id")
  goalText            String   @map("goal_text")
  linkedStrengths     String[] @map("linked_strengths")
  linkedWeaknesses    String[] @map("linked_weaknesses")
  linkedOpportunities String[] @map("linked_opportunities")
  linkedThreats       String[] @map("linked_threats")
  createdAt           DateTime @default(now()) @map("created_at")

  // swotAnalysisId is actually the toolRun id
  toolRun ToolRun    @relation(fields: [swotAnalysisId], references: [id], onDelete: Cascade)
  tasks   SwotTask[]

  @@index([swotAnalysisId])
  @@map("swot_custom_goals")
}

// ——————————————————————————————————————————————
// SWOT Tasks — مهام تنفيذية مرتبطة بأهداف SWOT
// ——————————————————————————————————————————————
model SwotTask {
  id                 String   @id @default(uuid())
  goalId             String   @map("goal_id")
  goalIndex          Int      @map("goal_index") // رقم الهدف (1, 2, 3...)
  taskIndex          Int      @map("task_index") // رقم المهمة داخل الهدف (1, 2, 3...)
  title              String // عنوان المهمة (الوسيلة)
  dueDate            DateTime @map("due_date") // تاريخ الإنجاز
  assignee           String // المسؤول عن التنفيذ
  follower           String // المعني بالمتابعة
  weight             Int // الوزن النسبي (1-100)
  cost               Float    @default(0) // التكلفة / الموازنة
  currency           String   @default("SAR") // العملة
  priority           String   @default("normal") // normal | medium | high
  status             String   @default("not_started") // not_started | in_progress | overdue | completed
  progress           Int      @default(0) // نسبة الإنجاز (0-100)
  budgetDistribution Json?    @map("budget_distribution") // خطة توزيع الميزانية
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  goal SwotCustomGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("swot_tasks")
}

// ——————————————————————————————————————————————
// Audit Logs — سجلات العمليات الإدارية الحساسة
// ——————————————————————————————————————————————
model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id") // Stores string like "SYSTEM_ADMIN"
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   String? // JSON string
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("audit_logs")
}

// ——————————————————————————————————————————————
// PEST Analysis — تحليل البيئة الخارجية (سياسي/اقتصادي/اجتماعي/تقني/قانوني)
// ——————————————————————————————————————————————
//  بخلاف SWOT (JSON داخل tool_runs) يُخزَّن كل بند في صفّ مستقل،
//  فيُعدَّل ويُرتَّب ويُولَّد جزئياً دون إعادة كتابة التحليل كله، ويُعرف مصدره
//  (يدوي/ذكاء اصطناعي/معدّل) لحماية عمل المستخدم عند إعادة التوليد.
//  toolRunId: سجل مرآة في tool_runs — به يظهر التحليل في لوحة التحكم
//  ويرث نظام الأقسام والرؤية والمشاركة القائم.
// ——————————————————————————————————————————————

enum PestDimension {
  political
  economic
  social
  technological
  legal

  @@map("pest_dimension")
}

enum PestCategory {
  trend
  positive_impact
  negative_impact

  @@map("pest_category")
}

enum PestFactorSource {
  manual
  ai
  ai_edited

  @@map("pest_factor_source")
}

enum PestCreationMode {
  manual
  ai
  hybrid

  @@map("pest_creation_mode")
}

enum PestStatus {
  draft
  completed

  @@map("pest_status")
}

enum PestGenerationScope {
  full
  dimension
  category

  @@map("pest_generation_scope")
}

model PestAnalysis {
  id                 String           @id @default(uuid()) @db.Uuid
  workspaceId        String           @map("workspace_id")
  departmentId       String?          @map("department_id") // «الفريق» في هذا المشروع = القسم
  toolRunId          String?          @unique @map("tool_run_id")
  createdById        String           @map("created_by")
  title              String
  projectName        String?          @map("project_name")
  projectDescription String?          @map("project_description")
  industry           String?
  countryRegion      String?          @map("country_region")
  status             PestStatus       @default(draft)
  creationMode       PestCreationMode @default(manual) @map("creation_mode")
  language           String           @default("ar")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department     Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  toolRun        ToolRun?            @relation(fields: [toolRunId], references: [id], onDelete: Cascade)
  createdBy      User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  factors        PestFactor[]
  generationLogs PestGenerationLog[]

  @@index([workspaceId, updatedAt])
  @@index([createdById])
  @@index([departmentId])
  @@map("pest_analyses")
}

model PestFactor {
  id          String           @id @default(uuid()) @db.Uuid
  analysisId  String           @map("analysis_id") @db.Uuid
  dimension   PestDimension
  category    PestCategory
  content     String           @db.Text
  sortOrder   Int              @default(0) @map("sort_order")
  source      PestFactorSource @default(manual)
  createdById String?          @map("created_by")
  // الانعكاس (إيجابي/سلبي) مرتبط ببند التوجه الأب في نفس البُعد — NULL للبنود القديمة والتوجهات نفسها
  parentFactorId String?       @map("parent_factor_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  analysis     PestAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  parent       PestFactor?  @relation("PestFactorImplications", fields: [parentFactorId], references: [id], onDelete: Cascade)
  implications PestFactor[] @relation("PestFactorImplications")

  @@unique([parentFactorId, category])
  @@index([analysisId, dimension, category, sortOrder])
  @@map("pest_factors")
}

model PestGenerationLog {
  id               String              @id @default(uuid()) @db.Uuid
  analysisId       String              @map("analysis_id") @db.Uuid
  userId           String              @map("user_id")
  scope            PestGenerationScope
  dimension        PestDimension?
  category         PestCategory?
  strategy         String              @default("replace") // replace | append
  model            String?
  promptTokens     Int                 @default(0) @map("prompt_tokens")
  completionTokens Int                 @default(0) @map("completion_tokens")
  totalTokens      Int                 @default(0) @map("total_tokens")
  itemsCount       Int                 @default(0) @map("items_count")
  createdAt        DateTime            @default(now()) @map("created_at")

  analysis PestAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([userId, createdAt])
  @@map("pest_generation_logs")
}

// ——————————————————————————————————————————————
// Porter's Five Forces — تحليل قوى بورتر الخمس
// ——————————————————————————————————————————————
//  على خلاف PEST (صفّ لكل بند) لكل قوة هنا ثلاثة نصوص حرّة فقط
//  (التوجهات / الانعكاسات الإيجابية / الانعكاسات السلبية)، فتُخزَّن
//  كل قوة في عمود JSON واحد بالشكل:
//    { "trends": "", "positiveImpacts": "", "negativeImpacts": "" }
//  ويُطبَّع الشكل ويُتحقَّق منه في porterService عند القراءة والكتابة.
//  toolRunId: سجل مرآة في tool_runs — به يظهر التحليل في لوحة التحكم
//  ويرث نظام الأقسام والرؤية والمشاركة القائم (كما في PEST).
// ——————————————————————————————————————————————

enum PorterStatus {
  draft
  completed

  @@map("porter_status")
}

enum PorterCreationMode {
  manual
  ai
  hybrid

  @@map("porter_creation_mode")
}

model PorterAnalysis {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @map("workspace_id")
  departmentId       String?            @map("department_id")
  toolRunId          String?            @unique @map("tool_run_id")
  createdById        String             @map("created_by")
  title              String
  projectName        String?            @map("project_name")
  projectDescription String?            @map("project_description")
  industry           String?
  countryRegion      String?            @map("country_region")
  newEntrants        Json               @default("{}") @map("new_entrants")
  buyers             Json               @default("{}")
  suppliers          Json               @default("{}")
  substitutes        Json               @default("{}")
  rivalry            Json               @default("{}")
  status             PorterStatus       @default(draft)
  creationMode       PorterCreationMode @default(manual) @map("creation_mode")
  language           String             @default("ar")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  toolRun    ToolRun?    @relation(fields: [toolRunId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
  @@index([createdById])
  @@index([departmentId])
  @@map("porter_analyses")
}

// ——————————————————————————————————————————————
// Chat & Calls Models (المحادثات والمكالمات)
// ——————————————————————————————————————————————

model Conversation {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  type          String    @default("direct") // "direct" | "group"
  title         String?
  createdById   String    @map("created_by_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]
  calls         Call[]

  @@index([workspaceId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  role           String       @default("member") // "admin" | "member"
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model UserPresence {
  userId      String   @id @map("user_id")
  workspaceId String   @map("workspace_id")
  status      String   @default("offline") // "online" | "offline"
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("user_presences")
}

model Call {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  workspaceId    String       @map("workspace_id")
  callerId       String       @map("caller_id")
  type           String       @default("audio") // "audio" | "video"
  status         String       @default("ringing") // "ringing" | "active" | "ended" | "missed" | "rejected" | "busy"
  roomName       String       @map("room_name")
  startedAt      DateTime?    @map("started_at")
  endedAt        DateTime?    @map("ended_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller         User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([workspaceId])
  @@map("calls")
}

